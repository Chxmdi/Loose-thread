# OpenAI — server only
OPENAI_API_KEY=
OPENAI_MODEL_INTERPRETER=
OPENAI_MODEL_CONTINUITY=
OPENAI_MODEL_RESUMPTION=
OPENAI_EMBEDDING_MODEL=

# Supabase — public client values may be used by mobile where appropriate
SUPABASE_URL=
# Preferred modern key names
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy equivalents also remain supported
SUPABASE_ANON_KEY=

# Server only — NEVER expose to mobile
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# API
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Expo client (publishable values only)
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Real-service demo harness (defaults to API_URL/SUPABASE_URL values when omitted)
DEMO_API_URL=http://127.0.0.1:8000
DEMO_SUPABASE_URL=
DEMO_SUPABASE_ANON_KEY=
DEMO_TIMEOUT_SECONDS=240

# Worker
JOB_POLL_SECONDS=1
JOB_MAX_ATTEMPTS=5
JOB_LEASE_SECONDS=120
WORKER_CONCURRENCY=4

# Deterministic retrieval tuning
RETRIEVAL_MINIMUM_SCORE=0.42
RETRIEVAL_WEIGHT_REDISCOVERY=0.22
RETRIEVAL_WEIGHT_CAPACITY=0.20
RETRIEVAL_WEIGHT_CONTEXT=0.14
RETRIEVAL_WEIGHT_OPEN_LOOP=0.14
RETRIEVAL_WEIGHT_THREAD_MOMENTUM=0.10
RETRIEVAL_WEIGHT_KIND_AFFINITY=0.08
RETRIEVAL_WEIGHT_TEMPORAL=0.07
RETRIEVAL_WEIGHT_NOVELTY=0.05
